# Biosphere Environment Variables
# GOV-006 §11: Environment variable documentation

# ── Logging ──────────────────────────────────────────────────────────────────
# Minimum log level: TRACE, DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL=INFO

# Path to JSONL log file (default: logs/biosphere.log)
# LOG_FILE_PATH=logs/biosphere.log

# Service name for structured log records
SERVICE_NAME=biosphere

# ── Simulation ───────────────────────────────────────────────────────────────
# Path to simulation config YAML
# BIOSPHERE_CONFIG=config/simulation.yaml
